{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Release Build",
            "type": "shell",
            "command": "cl",
            "args": [
                "/O2",
                "/GL",
                "/DNDEBUG",
                "/MT",
                "/EHsc",
                "main.cpp",
                "/link",
                "/SUBSYSTEM:WINDOWS",
                "/LTCG",
                "/DEBUG:NO"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}